Heure → Secondes
cint HeureEnSecondes(Heure h) {
    return (h.hh * 3600 + h.mm * 60 + h.ss);
}
Ex : 01:02:03 → 1×3600 + 2×60 + 3 = 3723 secondes
Secondes → Heure
cHeure SecondesEnHeure(int sec) {
    Heure h;
    h.hh = sec / 3600;     // partie heures
    sec  = sec % 3600;     // reste
    h.mm = sec / 60;       // partie minutes
    sec  = sec % 60;       // reste
    h.ss = sec;            // secondes
    return h;
}
